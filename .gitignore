# --- Python environments ---
.venv/
# pixi: commit pixi.toml AND pixi.lock (the lockfile is the reproducible env
# spec, like package-lock.json), but NEVER the materialised env under .pixi/
# (~1.3 GB of conda packages — this is what was blowing up the repo).
.pixi/

# --- cached intermediate reads (regenerated by the pipeline) ---
# Ignore the cache by default, BUT commit the ERA5T 0.25 deg annual-TXx fields:
# they distil a ~1 TB streaming read into ~600 KB, so they are kept in-repo as
# the durable copy of the expensive processed data (deploys never re-read the
# cloud for them). Everything else here — CMIP6 per-model fits, GMST, offsets,
# logs — is cheap to regenerate and stays ignored. See README "Processed data".
cache/*
!cache/era5t_txx_*.nc
# also keep the CMIP6 0.25 deg per-model fits, so grid_france_hires.json can be
# rebuilt fully offline (local_peak --reuse-event) without re-reading CMIP6.
!cache/cmip6_local_france_*.json

# --- logs and scratch ---
*.log
val_cmip.log
build.log

# --- python ---
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- web (Observable Framework) build + deps ---
web/node_modules/
web/dist/
web/.observablehq/cache/

# --- editor / OS noise ---
.DS_Store
*.swp
